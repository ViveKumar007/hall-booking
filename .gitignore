# Live mock data: json-server rewrites it on every run.
# start-mock.cmd creates it from mock/db.seed.json when it is missing.
hall-booking/mock/db.json

node_modules/
*.log
~$*

# Emails and reminders written by the worker
hall-booking/worker/outbox/

# Local connector secrets (SMTP login etc.); secrets.example.cmd is the committed template
hall-booking/scripts/secrets.cmd

# Spring Boot backend: build output, H2 database file, log file
backend-springboot/target/
backend-springboot/data/
backend-springboot/logs/

# React frontend build output (scripts/build-frontend.cmd)
frontend-react/dist/

# graphify knowledge-graph output (rebuild with /graphify)
graphify-out/

# Google OAuth client files downloaded from Google Cloud (contain the client secret)
client_secret_*.json
