<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HallBooking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_HallBooking">
    <bpmn:participant id="Participant_BookingDesk" name="Booking Desk" processRef="hall-booking" />
    <bpmn:participant id="Participant_HallAdmin" name="Hall Administration" processRef="hall-approval" />
    <bpmn:messageFlow id="MsgFlow_ApprovalRequest" name="approval request" sourceRef="Send_ApprovalRequest" targetRef="MsgStart_ApprovalRequested" />
    <bpmn:messageFlow id="MsgFlow_ApprovalDecision" name="decision" sourceRef="Send_Decision" targetRef="Receive_Decision" />
  </bpmn:collaboration>
  <bpmn:message id="Message_ApprovalRequest" name="booking-approval-request" />
  <bpmn:message id="Message_ApprovalDecision" name="booking-approval-decision">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=requestId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_ServiceDown" name="Booking service down" errorCode="BOOKING_SERVICE_DOWN" />

  <!-- ===================== Pool 1: Booking Desk ===================== -->
  <bpmn:process id="hall-booking" name="Seminar Hall and Lab Booking" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Requested" name="Booking requested">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="booking-request-form" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToPrepare</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Script_PrepareSlot" name="Prepare slot">
      <bpmn:extensionElements>
        <zeebe:script expression="={&#10;  startHour: number(substring(startTime, 1, 2)),&#10;  endHour: number(substring(endTime, 1, 2)),&#10;  durationHours: number(substring(endTime, 1, 2)) - number(substring(startTime, 1, 2))&#10;}" resultVariable="slot" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPrepare</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidate</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Worker_ValidateRequest" name="Validate request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-booking" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Request valid?" default="Flow_Valid">
      <bpmn:incoming>Flow_ToValid</bpmn:incoming>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_FetchRetry">
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:incoming>Flow_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFetch</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Rest_FetchBookings" name="Fetch existing bookings" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="{{secrets.MOCK_BASE_URL}}/bookings" target="url" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={existing: response.body}" />
          <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&#34;BOOKING_SERVICE_DOWN&#34;, &#34;Booking service unreachable&#34;, {serviceError: error.message}) else null" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDetect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_ServiceDown" name="Service down" attachedToRef="Rest_FetchBookings">
      <bpmn:outgoing>Flow_ServiceDown</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_ServiceDown" errorRef="Error_ServiceDown" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="User_FixService" name="Resolve service issue">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="service-fix-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ServiceDown</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFixAction</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FixAction" name="Retry?" default="Flow_Cancel">
      <bpmn:incoming>Flow_ToFixAction</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Script_SetServiceError" name="Set service error">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;SERVICE_UNAVAILABLE&#34;" resultVariable="outcome" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_ServiceErrorToMerge</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Script_DetectConflict" name="Detect conflict">
      <bpmn:extensionElements>
        <zeebe:script expression="={ hasConflict: count(existing[item.hall = venue and item.day = bookingDate and item.startHour &lt; slot.endHour and item.endHour &gt; slot.startHour]) &gt; 0 }" resultVariable="conflictCheck" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDetect</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSlotOk</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_SlotOk" name="Slot available?" default="Flow_SlotFree">
      <bpmn:incoming>Flow_ToSlotOk</bpmn:incoming>
      <bpmn:outgoing>Flow_SlotTaken</bpmn:outgoing>
      <bpmn:outgoing>Flow_SlotFree</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Script_SetReason" name="Set rejection reason">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;CONFLICT&#34;" resultVariable="outcome" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SlotTaken</bpmn:incoming>
      <bpmn:outgoing>Flow_ReasonToMerge</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Dmn_DecideApprover" name="Decide approver">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="decide-approver" resultVariable="approver" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SlotFree</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHold</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Rest_HoldSlot" name="Hold slot" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="{{secrets.MOCK_BASE_URL}}/bookings" target="url" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={hall: venue, day: bookingDate, startHour: slot.startHour, endHour: slot.endHour, status: &#34;PENDING&#34;, requester: requesterName}" target="body" />
          <zeebe:input source="false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={bookingId: response.body.id, bookingRef: &#34;BK-&#34; + string(response.body.id)}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToHold</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendRequest</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_ApprovalRequest" name="Send approval request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=requestId" target="correlationKey" />
          <zeebe:input source="={requesterName: requesterName, email: email, venue: venue, bookingDate: bookingDate, startTime: startTime, endTime: endTime, attendees: attendees, purpose: purpose, approver: approver, bookingId: bookingId, bookingRef: bookingRef, requestId: requestId}" target="messageVariables" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="booking-approval-request" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSendRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReceive</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Receive_Decision" name="Wait for decision" messageRef="Message_ApprovalDecision">
      <bpmn:incoming>Flow_ToReceive</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecision</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision?" default="Flow_Rejected">
      <bpmn:incoming>Flow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_Expired</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Rest_ConfirmSlot" name="Confirm slot" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="PATCH" target="method" />
          <zeebe:input source="=&#34;{{secrets.MOCK_BASE_URL}}/bookings/&#34; + string(bookingId)" target="url" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={status: &#34;CONFIRMED&#34;}" target="body" />
          <zeebe:input source="false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={outcome: &#34;APPROVED&#34;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Rest_ReleaseRejected" name="Release slot (rejected)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="DELETE" target="method" />
          <zeebe:input source="=&#34;{{secrets.MOCK_BASE_URL}}/bookings/&#34; + string(bookingId)" target="url" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={outcome: &#34;REJECTED&#34;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Rest_ReleaseExpired" name="Release slot (expired)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="DELETE" target="method" />
          <zeebe:input source="=&#34;{{secrets.MOCK_BASE_URL}}/bookings/&#34; + string(bookingId)" target="url" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={outcome: &#34;EXPIRED&#34;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Expired</bpmn:incoming>
      <bpmn:outgoing>Flow_ExpireToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:incoming>Flow_ReasonToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceErrorToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ConfirmToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_RejectToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ExpireToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Worker_Notify" name="Notify requester">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=email" target="to" />
          <zeebe:input source="=&#34;Hall booking &#34; + outcome" target="subject" />
          <zeebe:input source="=if outcome = &#34;APPROVED&#34; then &#34;Your booking of &#34; + venue + &#34; on &#34; + bookingDate + &#34; (&#34; + startTime + &#34;-&#34; + endTime + &#34;) is confirmed.&#34;&#10;else if outcome = &#34;REJECTED&#34; then &#34;Your booking request was rejected by the approver.&#34; + (if decision.remarks != null and decision.remarks != &#34;&#34; then &#34; Remarks: &#34; + decision.remarks else &#34;&#34;)&#10;else if outcome = &#34;EXPIRED&#34; then &#34;Your request was auto-cancelled because it was not approved in time.&#34;&#10;else if outcome = &#34;CONFLICT&#34; then &#34;That slot is already booked. Please choose another time.&#34;&#10;else if outcome = &#34;OVER_CAPACITY&#34; then venue + &#34; holds at most &#34; + string(validation.capacity) + &#34; people; you asked for &#34; + string(attendees) + &#34;.&#34;&#10;else if outcome = &#34;PAST_DATE&#34; then &#34;The booking date &#34; + bookingDate + &#34; has already passed.&#34;&#10;else if outcome = &#34;SERVICE_UNAVAILABLE&#34; then &#34;The booking service was unavailable, so your request was cancelled. Please try again later.&#34;&#10;else &#34;The end time must be after the start time.&#34;" target="message" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Done" name="Done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToPrepare" sourceRef="StartEvent_Requested" targetRef="Script_PrepareSlot" />
    <bpmn:sequenceFlow id="Flow_ToValidate" sourceRef="Script_PrepareSlot" targetRef="Worker_ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_ToValid" sourceRef="Worker_ValidateRequest" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_Invalid" name="Invalid" sourceRef="Gateway_Valid" targetRef="Gateway_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validation.valid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Valid" name="Valid" sourceRef="Gateway_Valid" targetRef="Gateway_FetchRetry" />
    <bpmn:sequenceFlow id="Flow_ToFetch" sourceRef="Gateway_FetchRetry" targetRef="Rest_FetchBookings" />
    <bpmn:sequenceFlow id="Flow_ServiceDown" sourceRef="Boundary_ServiceDown" targetRef="User_FixService" />
    <bpmn:sequenceFlow id="Flow_ToFixAction" sourceRef="User_FixService" targetRef="Gateway_FixAction" />
    <bpmn:sequenceFlow id="Flow_Retry" name="Retry" sourceRef="Gateway_FixAction" targetRef="Gateway_FetchRetry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=serviceFixAction = "RETRY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Cancel" name="Cancel" sourceRef="Gateway_FixAction" targetRef="Script_SetServiceError" />
    <bpmn:sequenceFlow id="Flow_ServiceErrorToMerge" sourceRef="Script_SetServiceError" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ToDetect" sourceRef="Rest_FetchBookings" targetRef="Script_DetectConflict" />
    <bpmn:sequenceFlow id="Flow_ToSlotOk" sourceRef="Script_DetectConflict" targetRef="Gateway_SlotOk" />
    <bpmn:sequenceFlow id="Flow_SlotTaken" name="Conflict" sourceRef="Gateway_SlotOk" targetRef="Script_SetReason">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=conflictCheck.hasConflict = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SlotFree" name="Free" sourceRef="Gateway_SlotOk" targetRef="Dmn_DecideApprover" />
    <bpmn:sequenceFlow id="Flow_ReasonToMerge" sourceRef="Script_SetReason" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ToHold" sourceRef="Dmn_DecideApprover" targetRef="Rest_HoldSlot" />
    <bpmn:sequenceFlow id="Flow_ToSendRequest" sourceRef="Rest_HoldSlot" targetRef="Send_ApprovalRequest" />
    <bpmn:sequenceFlow id="Flow_ToReceive" sourceRef="Send_ApprovalRequest" targetRef="Receive_Decision" />
    <bpmn:sequenceFlow id="Flow_ToDecision" sourceRef="Receive_Decision" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_Decision" targetRef="Rest_ConfirmSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision.outcome = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_Decision" targetRef="Rest_ReleaseRejected" />
    <bpmn:sequenceFlow id="Flow_Expired" name="Expired" sourceRef="Gateway_Decision" targetRef="Rest_ReleaseExpired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision.outcome = "EXPIRED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ConfirmToMerge" sourceRef="Rest_ConfirmSlot" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_RejectToMerge" sourceRef="Rest_ReleaseRejected" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ExpireToMerge" sourceRef="Rest_ReleaseExpired" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ToNotify" sourceRef="Gateway_Merge" targetRef="Worker_Notify" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Worker_Notify" targetRef="EndEvent_Done" />
  </bpmn:process>

  <!-- ===================== Pool 2: Hall Administration ===================== -->
  <bpmn:process id="hall-approval" name="Hall Approval" isExecutable="true">
    <bpmn:startEvent id="MsgStart_ApprovalRequested" name="Approval request received">
      <bpmn:outgoing>Flow_ToReview</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ApprovalRequest" messageRef="Message_ApprovalRequest" />
    </bpmn:startEvent>
    <bpmn:userTask id="User_Approval" name="Review booking">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="approval-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRecord</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Timer_Reminder" name="After 1 min" cancelActivity="false" attachedToRef="User_Approval">
      <bpmn:outgoing>Flow_Reminder</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Reminder">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_Timeout" name="After 2 min" attachedToRef="User_Approval">
      <bpmn:outgoing>Flow_Timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Worker_Reminder" name="Remind approver">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-reminder" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=approver" target="approverRole" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reminder</bpmn:incoming>
      <bpmn:outgoing>Flow_ReminderToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Reminded" name="Reminder sent">
      <bpmn:incoming>Flow_ReminderToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Script_RecordDecision" name="Record decision">
      <bpmn:extensionElements>
        <zeebe:script expression="={outcome: if approved = true then &#34;APPROVED&#34; else &#34;REJECTED&#34;, remarks: remarks}" resultVariable="decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordToMerge</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Script_MarkExpired" name="Mark as expired">
      <bpmn:extensionElements>
        <zeebe:script expression="={outcome: &#34;EXPIRED&#34;, remarks: &#34;Not reviewed within 2 minutes&#34;}" resultVariable="decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timeout</bpmn:incoming>
      <bpmn:outgoing>Flow_ExpiredToMerge</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_DecisionMerge">
      <bpmn:incoming>Flow_RecordToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ExpiredToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendDecision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Send_Decision" name="Send decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-message" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=requestId" target="correlationKey" />
          <zeebe:input source="={decision: decision}" target="messageVariables" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="messageName" value="booking-approval-decision" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSendDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecided</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Decided" name="Decision sent">
      <bpmn:incoming>Flow_ToDecided</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToReview" sourceRef="MsgStart_ApprovalRequested" targetRef="User_Approval" />
    <bpmn:sequenceFlow id="Flow_ToRecord" sourceRef="User_Approval" targetRef="Script_RecordDecision" />
    <bpmn:sequenceFlow id="Flow_Reminder" sourceRef="Timer_Reminder" targetRef="Worker_Reminder" />
    <bpmn:sequenceFlow id="Flow_ReminderToEnd" sourceRef="Worker_Reminder" targetRef="End_Reminded" />
    <bpmn:sequenceFlow id="Flow_Timeout" sourceRef="Timer_Timeout" targetRef="Script_MarkExpired" />
    <bpmn:sequenceFlow id="Flow_RecordToMerge" sourceRef="Script_RecordDecision" targetRef="Gateway_DecisionMerge" />
    <bpmn:sequenceFlow id="Flow_ExpiredToMerge" sourceRef="Script_MarkExpired" targetRef="Gateway_DecisionMerge" />
    <bpmn:sequenceFlow id="Flow_ToSendDecision" sourceRef="Gateway_DecisionMerge" targetRef="Send_Decision" />
    <bpmn:sequenceFlow id="Flow_ToDecided" sourceRef="Send_Decision" targetRef="End_Decided" />
  </bpmn:process>

