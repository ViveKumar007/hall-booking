<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HallBooking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:error id="Error_ServiceDown" name="Booking service down" errorCode="BOOKING_SERVICE_DOWN" />
  <bpmn:error id="Error_InvalidRequest" name="Invalid request" errorCode="INVALID_REQUEST" />
  <bpmn:error id="Error_EmailFailed" name="Email failed" errorCode="EMAIL_FAILED" />

  <bpmn:process id="hall-booking" name="Seminar Hall and Lab Booking" isExecutable="true">
    <bpmn:documentation>Main process. One request books one or more sessions (venue, date, hours). Parallel multi-instance checks, routes and holds every session; a sequential multi-instance Call Activity asks each approver in turn (child process hall-approval).</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_Requested" name="Booking requested">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="booking-request-form" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToPrepare</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Script_PrepareSlot" name="Prepare sessions">
      <bpmn:documentation>Adds slot = {startHour, endHour, durationHours} to every session.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression="=for s in sessions return context put(s, &#34;slot&#34;, {&#10;  startHour: number(substring(s.startTime, 1, 2)),&#10;  endHour: number(substring(s.endTime, 1, 2)),&#10;  durationHours: number(substring(s.endTime, 1, 2)) - number(substring(s.startTime, 1, 2))&#10;})" resultVariable="sessions" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPrepare</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidate</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Worker_ValidateRequest" name="Validate request">
      <bpmn:documentation>Job worker. Throws BPMN error INVALID_REQUEST (with variables validation, outcome) for bad times, past dates, too many people or sessions that overlap each other.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-booking" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_Invalid" name="Invalid request" attachedToRef="Worker_ValidateRequest">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=validation" target="validation" />
          <zeebe:output source="=outcome" target="outcome" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Invalid" errorRef="Error_InvalidRequest" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_FetchRetry">
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:incoming>Flow_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFetch</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:subProcess id="SubProcess_CheckAvailability" name="Check availability">
      <bpmn:documentation>Embedded sub-process. Error boundary: booking service down (connection refused or an error answer, at once). Timer boundary: service too slow, no answer within 30 s (the connector's read timeout is 60 s, so the timer fires first). Declares sessionChecks and conflictCheck locally and maps them out on completion.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="sessionChecks" />
          <zeebe:input source="=null" target="conflictCheck" />
          <zeebe:output source="=sessionChecks" target="sessionChecks" />
          <zeebe:output source="=conflictCheck" target="conflictCheck" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSlotOk</bpmn:outgoing>
      <bpmn:startEvent id="Start_Check">
        <bpmn:outgoing>Flow_CheckStart</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Rest_CheckSession" name="Check session" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
        <bpmn:documentation>REST connector, parallel multi-instance over sessions. Reads the bookings of that venue and day; any failure becomes BPMN error BOOKING_SERVICE_DOWN.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="apiKey" target="authentication.type" />
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="X-Register-Key" target="authentication.name" />
          <zeebe:input source="{{secrets.REGISTER_API_KEY}}" target="authentication.value" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="=&#34;{{secrets.BOOKING_API_URL}}/bookings?hall=&#34; + session.venue + &#34;&amp;day=&#34; + session.bookingDate" target="url" />
            <zeebe:input source="false" target="storeResponse" />
            <zeebe:input source="20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="60" target="readTimeoutInSeconds" />
            <zeebe:input source="=null" target="existing" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="12" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={existing: response.body}" />
            <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&#34;BOOKING_SERVICE_DOWN&#34;, &#34;Booking service unreachable&#34;, {serviceError: if error.message = null or error.message = &#34;&#34; then &#34;The booking service answered with error &#34; + string(error.code) + &#34;.&#34; else error.message}) else null" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckStart</bpmn:incoming>
        <bpmn:outgoing>Flow_ToDetect</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics>
          <bpmn:extensionElements>
            <zeebe:loopCharacteristics inputCollection="=sessions" inputElement="session" outputCollection="sessionChecks" outputElement="={venue: session.venue, bookingDate: session.bookingDate, startTime: session.startTime, endTime: session.endTime, clash: count(existing[item.startHour &lt; session.slot.endHour and item.endHour &gt; session.slot.startHour]) &gt; 0}" />
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="Script_DetectConflict" name="Detect conflict">
        <bpmn:extensionElements>
          <zeebe:script expression="={hasConflict: some c in sessionChecks satisfies c.clash, clashes: sessionChecks[item.clash]}" resultVariable="conflictCheck" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ToDetect</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckEnd</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:endEvent id="End_Check">
        <bpmn:incoming>Flow_CheckEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_CheckStart" sourceRef="Start_Check" targetRef="Rest_CheckSession" />
      <bpmn:sequenceFlow id="Flow_ToDetect" sourceRef="Rest_CheckSession" targetRef="Script_DetectConflict" />
      <bpmn:sequenceFlow id="Flow_CheckEnd" sourceRef="Script_DetectConflict" targetRef="End_Check" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_ServiceDown" name="Service down" attachedToRef="SubProcess_CheckAvailability">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=serviceError" target="serviceError" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ServiceDown</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_ServiceDown" errorRef="Error_ServiceDown" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Timer_CheckTimeout" name="After 30 s" attachedToRef="SubProcess_CheckAvailability">
      <bpmn:outgoing>Flow_Timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_CheckTimeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="Script_SetTimeoutError" name="Set timeout error">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;The booking service did not answer within 30 seconds.&#34;" resultVariable="serviceError" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timeout</bpmn:incoming>
      <bpmn:outgoing>Flow_TimeoutToIssue</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_ServiceIssue">
      <bpmn:incoming>Flow_ServiceDown</bpmn:incoming>
      <bpmn:incoming>Flow_TimeoutToIssue</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEmailAdmin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CallActivity_EmailAdmin" name="Email admins: service issue">
      <bpmn:documentation>Call Activity to the reusable send-email process: tells the admins the booking register is not answering, so they can retry or cancel.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-email" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="to" />
          <zeebe:input source="=&#34;admin&#34;" target="toRole" />
          <zeebe:input source="=&#34;Action needed: the booking service is not answering&#34;" target="subject" />
          <zeebe:input source="=&#34;The booking register could not be reached while checking a request from &#34; + requesterName + &#34; (&#34; + email + &#34;).\n&#34; + (if serviceError = null then &#34;&#34; else &#34;Error: &#34; + serviceError + &#34;\n&#34;) + &#34;\nThe request waits under Service issues: choose Retry once the service is back, or Cancel to tell the requester.\n\nHall Booking&#34;" target="body" />
          <zeebe:input source="=&#34;/#/issues&#34;" target="link" />
          <zeebe:output source="={status: emailStatus, to: recipients, error: emailError}" target="serviceEmail" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEmailAdmin</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFix</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="User_FixService" name="Resolve service issue">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="service-fix-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFix</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFixAction</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FixAction" name="Retry?" default="Flow_Cancel">
      <bpmn:incoming>Flow_ToFixAction</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Script_SetServiceError" name="Set service error">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;SERVICE_UNAVAILABLE&#34;" resultVariable="outcome" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_ServiceErrorToMerge</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_SlotOk" name="All sessions free?" default="Flow_SlotFree">
      <bpmn:incoming>Flow_ToSlotOk</bpmn:incoming>
      <bpmn:outgoing>Flow_SlotTaken</bpmn:outgoing>
      <bpmn:outgoing>Flow_SlotFree</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Script_SetReason" name="Set rejection reason">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;CONFLICT&#34;" resultVariable="outcome" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SlotTaken</bpmn:incoming>
      <bpmn:outgoing>Flow_ReasonToMerge</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Dmn_DecideApprover" name="Decide approver">
      <bpmn:documentation>DMN decide-approver, parallel multi-instance: one approver per session, collected in sessionApprovers.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="decide-approver" resultVariable="approver" />
        <zeebe:ioMapping>
          <zeebe:input source="=session.venue" target="venue" />
          <zeebe:input source="=session.slot" target="slot" />
          <zeebe:input source="=null" target="approver" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SlotFree</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPlan</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=sessions" inputElement="session" outputCollection="sessionApprovers" outputElement="=approver" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="Script_PlanApprovals" name="Plan approval chain">
      <bpmn:extensionElements>
        <zeebe:script expression="=distinct values(sessionApprovers)" resultVariable="approvers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPlan</bpmn:incoming>
      <bpmn:outgoing>Flow_ToHold</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Rest_HoldSlot" name="Hold slot" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:documentation>REST connector, parallel multi-instance: one PENDING booking per session, collected in heldSlots.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="apiKey" target="authentication.type" />
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="X-Register-Key" target="authentication.name" />
          <zeebe:input source="{{secrets.REGISTER_API_KEY}}" target="authentication.value" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="{{secrets.BOOKING_API_URL}}/bookings" target="url" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={hall: session.venue, day: session.bookingDate, startHour: session.slot.startHour, endHour: session.slot.endHour, status: &#34;PENDING&#34;, requester: requesterName}" target="body" />
          <zeebe:input source="false" target="ignoreNullValues" />
          <zeebe:input source="=null" target="bookingId" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={bookingId: response.body.id}" />
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToHold</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEmailReceived</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=sessions" inputElement="session" outputCollection="heldSlots" outputElement="={id: bookingId, ref: &#34;BK-&#34; + string(bookingId), venue: session.venue, bookingDate: session.bookingDate, startTime: session.startTime, endTime: session.endTime}" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:callActivity id="CallActivity_EmailReceived" name="Email requester: received">
      <bpmn:documentation>Call Activity to the reusable send-email process: tells the requester the slots are held and who reviews the request next.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-email" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=email" target="to" />
          <zeebe:input source="=null" target="toRole" />
          <zeebe:input source="=&#34;Hall booking request received: &#34; + string join(for h in heldSlots return h.ref, &#34;, &#34;)" target="subject" />
          <zeebe:input source="=&#34;Dear &#34; + requesterName + &#34;,\n\nWe have received your booking request and are holding these sessions for you while it is reviewed:\n&#34; + string join(for s in sessions return &#34;- &#34; + s.venue + &#34; on &#34; + s.bookingDate + &#34;, &#34; + s.startTime + &#34;-&#34; + s.endTime, &#34;\n&#34;) + &#34;\n\nBooking reference: &#34; + string join(for h in heldSlots return h.ref, &#34;, &#34;) + &#34;\nIt now goes to: &#34; + string join(for a in approvers return get value({&#34;admin-office&#34;: &#34;Admin office&#34;, &#34;dean&#34;: &#34;Dean&#34;, &#34;hod&#34;: &#34;HOD&#34;, &#34;lab-incharge&#34;: &#34;Lab in-charge&#34;}, a), &#34;, then &#34;) + &#34;. You will get another email with the decision.\n\nHall Booking Office&#34;" target="body" />
          <zeebe:input source="=&#34;/#/requests&#34;" target="link" />
          <zeebe:output source="={status: emailStatus, to: recipients, error: emailError}" target="receivedEmail" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEmailReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApproval</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="CallActivity_Approval" name="Get approval">
      <bpmn:documentation>Call Activity to the reusable child process hall-approval, sequential multi-instance over approvers. Stops at the first decision that is not APPROVED.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="hall-approval" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=approver" target="approver" />
          <zeebe:input source="=loopCounter" target="approvalStep" />
          <zeebe:input source="=count(approvers)" target="approvalSteps" />
          <zeebe:input source="=requesterName" target="requesterName" />
          <zeebe:input source="=email" target="email" />
          <zeebe:input source="=attendees" target="attendees" />
          <zeebe:input source="=purpose" target="purpose" />
          <zeebe:input source="=sessions" target="sessions" />
          <zeebe:input source="=string join(for h in heldSlots return h.ref, &#34;, &#34;)" target="bookingRef" />
          <zeebe:input source="=if approvalTimes = null then {timeout: &#34;P1D&#34;, reminder: &#34;PT1H&#34;, timeoutText: &#34;1 day&#34;, reminderText: &#34;1 hour&#34;, leftText: &#34;23 hours&#34;} else approvalTimes" target="approvalTimes" />
          <zeebe:input source="=null" target="decision" />
          <zeebe:output source="=decision" target="decision" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSummarize</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=approvers" inputElement="approver" outputCollection="decisions" outputElement="=decision" />
        </bpmn:extensionElements>
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">=decision != null and decision.outcome != "APPROVED"</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:scriptTask id="Script_SummarizeDecision" name="Combine decisions">
      <bpmn:extensionElements>
        <zeebe:script expression="=if every d in decisions satisfies d != null and d.outcome = &#34;APPROVED&#34;&#10;then {outcome: &#34;APPROVED&#34;, approver: string join(approvers, &#34;, &#34;), remarks: string join(for d in decisions[item.remarks != null and item.remarks != &#34;&#34;] return d.approver + &#34;: &#34; + d.remarks, &#34;; &#34;)}&#10;else (decisions[item != null and item.outcome != &#34;APPROVED&#34;])[1]" resultVariable="decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSummarize</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecision</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision?" default="Flow_Rejected">
      <bpmn:incoming>Flow_ToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_Expired</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Rest_ConfirmSlot" name="Confirm slot" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="apiKey" target="authentication.type" />
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="X-Register-Key" target="authentication.name" />
          <zeebe:input source="{{secrets.REGISTER_API_KEY}}" target="authentication.value" />
          <zeebe:input source="PATCH" target="method" />
          <zeebe:input source="=&#34;{{secrets.BOOKING_API_URL}}/bookings/&#34; + string(held.id)" target="url" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={status: &#34;CONFIRMED&#34;}" target="body" />
          <zeebe:input source="false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={outcome: &#34;APPROVED&#34;}" />
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmToMerge</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=heldSlots" inputElement="held" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Rest_ReleaseRejected" name="Release slot (rejected)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="apiKey" target="authentication.type" />
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="X-Register-Key" target="authentication.name" />
          <zeebe:input source="{{secrets.REGISTER_API_KEY}}" target="authentication.value" />
          <zeebe:input source="DELETE" target="method" />
          <zeebe:input source="=&#34;{{secrets.BOOKING_API_URL}}/bookings/&#34; + string(held.id)" target="url" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={outcome: &#34;REJECTED&#34;}" />
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectToMerge</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=heldSlots" inputElement="held" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Rest_ReleaseExpired" name="Release slot (expired)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="apiKey" target="authentication.type" />
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="X-Register-Key" target="authentication.name" />
          <zeebe:input source="{{secrets.REGISTER_API_KEY}}" target="authentication.value" />
          <zeebe:input source="DELETE" target="method" />
          <zeebe:input source="=&#34;{{secrets.BOOKING_API_URL}}/bookings/&#34; + string(held.id)" target="url" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={outcome: &#34;EXPIRED&#34;}" />
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Expired</bpmn:incoming>
      <bpmn:outgoing>Flow_ExpireToMerge</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=heldSlots" inputElement="held" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:incoming>Flow_ReasonToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ServiceErrorToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ConfirmToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_RejectToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ExpireToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Script_ComposeNotification" name="Compose notification">
      <bpmn:documentation>FEEL: builds the requester's message once (one sentence per outcome), used by both the email and the notification record.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression="={&#10;  to: email,&#10;  subject: &#34;Hall booking &#34; + outcome,&#10;  bookingRef: if heldSlots = null then null else string join(for h in heldSlots return h.ref, &#34;, &#34;),&#10;  message: if outcome = &#34;APPROVED&#34; then&#34;Your booking is confirmed: &#34; + string join(for s in sessions return s.venue + &#34; on &#34; + s.bookingDate + &#34; (&#34; + s.startTime + &#34;-&#34; + s.endTime + &#34;)&#34;, &#34;; &#34;) + &#34;.&#34;&#10;else if outcome = &#34;REJECTED&#34; then &#34;Your booking request was rejected by &#34; + decision.approver + &#34;.&#34; + (if decision.remarks != null and decision.remarks != &#34;&#34; then &#34; Remarks: &#34; + decision.remarks else &#34;&#34;)&#10;else if outcome = &#34;EXPIRED&#34; then &#34;Your request was cancelled because &#34; + decision.approver + &#34; did not review it in time.&#34;&#10;else if outcome = &#34;CONFLICT&#34; then &#34;These sessions clash with existing bookings: &#34; + string join(for c in conflictCheck.clashes return c.venue + &#34; on &#34; + c.bookingDate + &#34; (&#34; + c.startTime + &#34;-&#34; + c.endTime + &#34;)&#34;, &#34;; &#34;) + &#34;. Please choose other times.&#34;&#10;else if outcome = &#34;SERVICE_UNAVAILABLE&#34; then &#34;The booking service was unavailable, so your request was cancelled. Please try again later.&#34;&#10;else validation.message,&#10;  body: &#34;Dear &#34; + requesterName + &#34;,\n\n&#34; + message + (if bookingRef = null then &#34;&#34; else &#34;\nBooking reference: &#34; + bookingRef) + &#34;\n\nHall Booking Office&#34;&#10;}" resultVariable="notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEmail</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Email_NotifyRequester" name="Email requester" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="3">
      <bpmn:documentation>Email Outbound Connector (SMTP). Server, port, login and sender come from connector secrets. Any failure becomes BPMN error EMAIL_FAILED, so the booking still finishes and the failure is recorded.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="simple" target="authentication.type" />
          <zeebe:input source="{{secrets.SMTP_USERNAME}}" target="authentication.username" />
          <zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="authentication.password" />
          <zeebe:input source="smtp" target="protocol" />
          <zeebe:input source="{{secrets.SMTP_HOST}}" target="data.smtpConfig.smtpHost" />
          <zeebe:input source="{{secrets.SMTP_PORT}}" target="data.smtpConfig.smtpPort" />
          <zeebe:input source="{{secrets.SMTP_SECURITY}}" target="data.smtpConfig.smtpCryptographicProtocol" />
          <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
          <zeebe:input source="{{secrets.MAIL_FROM}}" target="data.smtpAction.from" />
          <zeebe:input source="=notification.to" target="data.smtpAction.to" />
          <zeebe:input source="=notification.subject" target="data.smtpAction.subject" />
          <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
          <zeebe:input source="=notification.body" target="data.smtpAction.body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="3" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" />
          <zeebe:header key="resultExpression" value="={emailStatus: &#34;SENT&#34;}" />
          <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&#34;EMAIL_FAILED&#34;, &#34;Email could not be sent&#34;, {emailError: error.message}) else null" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_EmailSent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_EmailFailed" name="Email failed" attachedToRef="Email_NotifyRequester">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=emailError" target="emailError" />
          <zeebe:output source="=&#34;FAILED&#34;" target="emailStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_EmailFailed</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_EmailFailed" errorRef="Error_EmailFailed" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_NotifyMerge">
      <bpmn:incoming>Flow_EmailSent</bpmn:incoming>
      <bpmn:incoming>Flow_EmailFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRecord</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Worker_Notify" name="Record notification">
      <bpmn:documentation>Job worker: records the notification (and whether the email went out) in the booking service's /notifications list and in worker/outbox.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-notification" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=notification.to" target="to" />
          <zeebe:input source="=notification.subject" target="subject" />
          <zeebe:input source="=notification.message" target="message" />
          <zeebe:input source="=notification.bookingRef" target="bookingRef" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Done" name="Done">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToPrepare" sourceRef="StartEvent_Requested" targetRef="Script_PrepareSlot" />
    <bpmn:sequenceFlow id="Flow_ToValidate" sourceRef="Script_PrepareSlot" targetRef="Worker_ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_Valid" name="Valid" sourceRef="Worker_ValidateRequest" targetRef="Gateway_FetchRetry" />
    <bpmn:sequenceFlow id="Flow_Invalid" sourceRef="Boundary_Invalid" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ToFetch" sourceRef="Gateway_FetchRetry" targetRef="SubProcess_CheckAvailability" />
    <bpmn:sequenceFlow id="Flow_ServiceDown" sourceRef="Boundary_ServiceDown" targetRef="Gateway_ServiceIssue" />
    <bpmn:sequenceFlow id="Flow_Timeout" sourceRef="Timer_CheckTimeout" targetRef="Script_SetTimeoutError" />
    <bpmn:sequenceFlow id="Flow_TimeoutToIssue" sourceRef="Script_SetTimeoutError" targetRef="Gateway_ServiceIssue" />
    <bpmn:sequenceFlow id="Flow_ToEmailAdmin" sourceRef="Gateway_ServiceIssue" targetRef="CallActivity_EmailAdmin" />
    <bpmn:sequenceFlow id="Flow_ToFix" sourceRef="CallActivity_EmailAdmin" targetRef="User_FixService" />
    <bpmn:sequenceFlow id="Flow_ToFixAction" sourceRef="User_FixService" targetRef="Gateway_FixAction" />
    <bpmn:sequenceFlow id="Flow_Retry" name="Retry" sourceRef="Gateway_FixAction" targetRef="Gateway_FetchRetry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=serviceFixAction = "RETRY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Cancel" name="Cancel" sourceRef="Gateway_FixAction" targetRef="Script_SetServiceError" />
    <bpmn:sequenceFlow id="Flow_ServiceErrorToMerge" sourceRef="Script_SetServiceError" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ToSlotOk" sourceRef="SubProcess_CheckAvailability" targetRef="Gateway_SlotOk" />
    <bpmn:sequenceFlow id="Flow_SlotTaken" name="Clash" sourceRef="Gateway_SlotOk" targetRef="Script_SetReason">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=conflictCheck.hasConflict = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SlotFree" name="Free" sourceRef="Gateway_SlotOk" targetRef="Dmn_DecideApprover" />
    <bpmn:sequenceFlow id="Flow_ReasonToMerge" sourceRef="Script_SetReason" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ToPlan" sourceRef="Dmn_DecideApprover" targetRef="Script_PlanApprovals" />
    <bpmn:sequenceFlow id="Flow_ToHold" sourceRef="Script_PlanApprovals" targetRef="Rest_HoldSlot" />
    <bpmn:sequenceFlow id="Flow_ToEmailReceived" sourceRef="Rest_HoldSlot" targetRef="CallActivity_EmailReceived" />
    <bpmn:sequenceFlow id="Flow_ToApproval" sourceRef="CallActivity_EmailReceived" targetRef="CallActivity_Approval" />
    <bpmn:sequenceFlow id="Flow_ToSummarize" sourceRef="CallActivity_Approval" targetRef="Script_SummarizeDecision" />
    <bpmn:sequenceFlow id="Flow_ToDecision" sourceRef="Script_SummarizeDecision" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_Decision" targetRef="Rest_ConfirmSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision.outcome = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_Decision" targetRef="Rest_ReleaseRejected" />
    <bpmn:sequenceFlow id="Flow_Expired" name="Expired" sourceRef="Gateway_Decision" targetRef="Rest_ReleaseExpired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision.outcome = "EXPIRED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ConfirmToMerge" sourceRef="Rest_ConfirmSlot" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_RejectToMerge" sourceRef="Rest_ReleaseRejected" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ExpireToMerge" sourceRef="Rest_ReleaseExpired" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_ToNotify" sourceRef="Gateway_Merge" targetRef="Script_ComposeNotification" />
    <bpmn:sequenceFlow id="Flow_ToEmail" sourceRef="Script_ComposeNotification" targetRef="Email_NotifyRequester" />
    <bpmn:sequenceFlow id="Flow_EmailSent" sourceRef="Email_NotifyRequester" targetRef="Gateway_NotifyMerge" />
    <bpmn:sequenceFlow id="Flow_EmailFailed" sourceRef="Boundary_EmailFailed" targetRef="Gateway_NotifyMerge" />
    <bpmn:sequenceFlow id="Flow_ToRecord" sourceRef="Gateway_NotifyMerge" targetRef="Worker_Notify" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Worker_Notify" targetRef="EndEvent_Done" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_HallBooking">
    <bpmndi:BPMNPlane id="BPMNPlane_HallBooking" bpmnElement="hall-booking">
      <bpmndi:BPMNShape id="StartEvent_Requested_di" bpmnElement="StartEvent_Requested"><dc:Bounds x="152" y="242" width="36" height="36" /></bpmndi:BPMNShape>
