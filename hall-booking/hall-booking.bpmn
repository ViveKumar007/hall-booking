      <bpmndi:BPMNShape id="End_Check_di" bpmnElement="End_Check"><dc:Bounds x="1002" y="242" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Script_SetTimeoutError_di" bpmnElement="Script_SetTimeoutError"><dc:Bounds x="910" y="430" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ServiceIssue_di" bpmnElement="Gateway_ServiceIssue" isMarkerVisible="true"><dc:Bounds x="735" y="445" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="User_FixService_di" bpmnElement="User_FixService"><dc:Bounds x="600" y="430" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_FixAction_di" bpmnElement="Gateway_FixAction" isMarkerVisible="true"><dc:Bounds x="525" y="445" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="486" y="463" width="32" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Script_SetServiceError_di" bpmnElement="Script_SetServiceError"><dc:Bounds x="500" y="550" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SlotOk_di" bpmnElement="Gateway_SlotOk" isMarkerVisible="true"><dc:Bounds x="1105" y="235" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1086" y="207" width="88" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Script_SetReason_di" bpmnElement="Script_SetReason"><dc:Bounds x="1080" y="430" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Dmn_DecideApprover_di" bpmnElement="Dmn_DecideApprover"><dc:Bounds x="1200" y="220" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Script_PlanApprovals_di" bpmnElement="Script_PlanApprovals"><dc:Bounds x="1340" y="220" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Rest_HoldSlot_di" bpmnElement="Rest_HoldSlot"><dc:Bounds x="1480" y="220" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallActivity_EmailReceived_di" bpmnElement="CallActivity_EmailReceived"><dc:Bounds x="1620" y="220" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallActivity_EmailAdmin_di" bpmnElement="CallActivity_EmailAdmin"><dc:Bounds x="710" y="550" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallActivity_Approval_di" bpmnElement="CallActivity_Approval"><dc:Bounds x="1760" y="220" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Script_SummarizeDecision_di" bpmnElement="Script_SummarizeDecision"><dc:Bounds x="1900" y="220" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true"><dc:Bounds x="2045" y="235" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2006" y="290" width="46" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Rest_ConfirmSlot_di" bpmnElement="Rest_ConfirmSlot"><dc:Bounds x="2140" y="100" width="100" height="80" /></bpmndi:BPMNShape>
