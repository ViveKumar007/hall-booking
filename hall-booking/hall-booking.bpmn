      <bpmndi:BPMNShape id="Gateway_NotifyMerge_di" bpmnElement="Gateway_NotifyMerge" isMarkerVisible="true"><dc:Bounds x="2665" y="235" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Worker_Notify_di" bpmnElement="Worker_Notify"><dc:Bounds x="2760" y="220" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Done_di" bpmnElement="EndEvent_Done"><dc:Bounds x="2912" y="242" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_EmailFailed_di" bpmnElement="Boundary_EmailFailed"><dc:Bounds x="2552" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2578" y="322" width="58" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_Invalid_di" bpmnElement="Boundary_Invalid"><dc:Bounds x="412" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="452" y="322" width="74" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_ServiceDown_di" bpmnElement="Boundary_ServiceDown"><dc:Bounds x="742" y="352" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="768" y="392" width="64" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_CheckTimeout_di" bpmnElement="Timer_CheckTimeout"><dc:Bounds x="942" y="352" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="968" y="392" width="50" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ToPrepare_di" bpmnElement="Flow_ToPrepare"><di:waypoint x="188" y="260" /><di:waypoint x="230" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToValidate_di" bpmnElement="Flow_ToValidate"><di:waypoint x="330" y="260" /><di:waypoint x="380" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Valid_di" bpmnElement="Flow_Valid"><di:waypoint x="480" y="260" /><di:waypoint x="525" y="260" /></bpmndi:BPMNEdge>
