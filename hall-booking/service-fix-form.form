{
  "components": [
    {
      "text": "# Booking service unavailable\nThe booking database could not be reached while handling **{{requesterName}}**'s request for **{{venue}}** on **{{bookingDate}}** ({{startTime}} to {{endTime}}).\n\n**Error:** {{serviceError}}\n\nCheck that the booking service (mock API window) is running, then choose **Retry**. Choose **Cancel** to stop this request and notify the requester.",
      "type": "text",
      "id": "Text_ServiceIssue",
      "layout": { "row": "Row_Issue", "columns": null }
    },
    {
      "label": "What should happen?",
      "type": "radio",
      "id": "Field_ServiceFixAction",
      "key": "serviceFixAction",
      "values": [
        { "label": "Retry now", "value": "RETRY" },
        { "label": "Cancel the booking", "value": "CANCEL" }
      ],
      "defaultValue": "RETRY",
      "validate": { "required": true },
      "layout": { "row": "Row_Action", "columns": null }
    }
  ],
  "type": "default",
  "id": "service-fix-form",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "exporter": { "name": "Camunda Modeler", "version": "5.49.0" },
  "schemaVersion": 19
}
